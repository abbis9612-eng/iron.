<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the engine-independent simulation code and its EditMode tests outside Unity,
    so they can be checked on any machine or in CI. Unity ignores this folder.
    The same .cs files are compiled by Unity; this project only adds a second runner.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 6 compiles C# 9: keep the shared sources within it. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>IronHorizon.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Assets/_Project/Scripts/Core/Sim/**/*.cs" />
    <Compile Include="../Assets/_Project/Scripts/Core/Infra/**/*.cs" />
    <Compile Include="../Assets/_Project/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
